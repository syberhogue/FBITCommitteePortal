# Browser-safe values. For local Supabase, obtain these with `npm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-local-secret-or-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FBIT Committee Portal
NEXT_PUBLIC_INSTITUTION_NAME=Your University
SUPPORT_EMAIL=support@example.edu

# Optional safety guard. Set to production only on the Vercel production environment.
DEPLOYMENT_ENV=development
